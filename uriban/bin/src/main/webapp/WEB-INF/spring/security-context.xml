<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:security="http://www.springframework.org/schema/security"
	xsi:schemaLocation="http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security-5.3.xsd
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.3.xsd">
		
	<!-- security가 적용되면 안되는 경우 -->
	
	<security:http pattern="/assets/**" security="none" />
	
	
	<security:http>
		<!-- security:intercept-url : security가 적용되는 대상  -->
		<security:intercept-url pattern="/" access="permitAll()" />
		<security:intercept-url pattern="/login" access="permitAll()" />
		<security:intercept-url pattern="/signup/**" access="permitAll()" /> <!-- access:접근권한, permitAll(): 모든사람 -->
		<security:intercept-url pattern="/admin/**" access="hasAuthority('ADMIN')" />
		<security:intercept-url pattern="/**" access="isAuthenticated()" /> <!--  isAuthenticated() : 위에서 인증 받았으면 접근 가능 -->
		<security:form-login
			username-parameter="memberId"
	        password-parameter="memberPw"
	        login-processing-url="/login"
	        login-page="/login"
	        default-target-url="/"
		
		/>
		<!-- <security:form-login default-target-url="/login" /> -->
		
		<!-- <security:logout logout-url="/logout" logout-success-url="/" /> -->
		<security:logout 
			logout-success-url="/" />
		<!-- <security:csrf disabled="true" /> -->
	</security:http>
	
	<bean id="userDetailsService" class="com.yedam.uriban.member.service.CustomerUserDetailsService" />
	
	<security:authentication-manager>
		<security:authentication-provider user-service-ref="userDetailsService"/>
	</security:authentication-manager>

</beans>