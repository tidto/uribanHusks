<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
"-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN"
"http://tiles.apache.org/dtds/tiles-config_3_0.dtd">

<tiles-definitions>

	<definition name="mainTemplate" template="/WEB-INF/views/tiles/layout.jsp"> <!-- name에는 Controller에서 사용되지 않은(않을) 고유한 이름 -->
		<put-attribute name="side" value="/WEB-INF/views/tiles/nav.jsp"/>
		<put-attribute name="header" value="/WEB-INF/views/tiles/header.jsp"/>
		<put-attribute name="footer" value="/WEB-INF/views/tiles/footer.jsp"/>
	</definition>
	
	<!-- 
	<definition name="adminMainTemplate" template=""/>
	<definition name="admin/*" extends="adminMainTemplate"/>
	-->
	<definition name="home" extends="mainTemplate">
		<put-attribute name="content" value="/WEB-INF/views/home.jsp"/>
	</definition>
	
	<definition name="*/*" extends="mainTemplate"> <!-- template 속성을 사용하는 definition 밑에 와야함. 상속 대상을 extends에 작성 -->
		<put-attribute name="content" value="/WEB-INF/views/{1}/{2}.jsp"/>
	</definition>
	
	
</tiles-definitions>